#!/bin/bash
set -e

if [ "$1" = "configure" ]; then
    # 专用系统用户（不再以 root 运行）
    if ! getent passwd unbound-dashboard >/dev/null; then
        useradd --system --no-create-home --shell /usr/sbin/nologin \
            --gid unbound unbound-dashboard 2>/dev/null || \
        useradd --system --no-create-home --shell /usr/sbin/nologin unbound-dashboard
    fi

    # 数据目录：服务需要写 SQLite，Unbound 需要能连 socket
    mkdir -p /var/lib/unbound
    chmod 775 /var/lib/unbound
    chown unbound-dashboard:unbound /var/lib/unbound 2>/dev/null || true
    # 已有的 dashboard.db 也要能写
    if [ -f /var/lib/unbound/dashboard.db ]; then
        chown unbound-dashboard:unbound /var/lib/unbound/dashboard.db 2>/dev/null || true
        chmod 660 /var/lib/unbound/dashboard.db 2>/dev/null || true
    fi

    systemctl daemon-reload

    echo ""
    echo "=== unbound-dashboard installed ==="
    echo ""
    echo "1. Edit the service file to set your data source:"
    echo "   sudo systemctl edit unbound-dashboard"
    echo ""
    echo "2. Enable and start:"
    echo "   sudo systemctl enable --now unbound-dashboard"
    echo ""
    echo "3. Open http://localhost:9153 in your browser"
    echo "   Metrics: http://localhost:9153/metrics"
    echo ""
fi

#DEBHELPER#
exit 0
